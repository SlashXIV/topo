{
    "build_abis": ["arm64-v8a", "x86_64"],
    "android_min_sdk_version": 26,
    "android_target_sdk_version": 35,
    "build_params": [
        "--enable_lto",
        "--android",
        "--parallel", "10",
        "--cmake_generator=Ninja",
        "--build_java",
        "--build_shared_lib",
        "--use_xnnpack",
        "--disable_ml_ops",
        "--skip_tests",
        "--cmake_extra_defines", "onnxruntime_BUILD_UNIT_TESTS=OFF"
    ]
}
