<?xml version="1.0" encoding="utf-8"?>
<!--
    Avant-plan de l'icone, decoupe en groupes nommes pour l'animation du demarrage
    (avd_splash). Memes trace que ic_launcher_foreground : la lettre et le trait.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:name="letter">
        <path
            android:name="letter_path"
            android:fillColor="@color/icon_letter"
            android:pathData="M40,35L68,35L68,44L58.5,44L58.5,64L49.5,64L49.5,44L40,44Z" />
    </group>

    <!-- Pivot a gauche du trait : il se deroule de gauche a droite, comme un trace. -->
    <group
        android:name="bar"
        android:pivotX="38.5"
        android:pivotY="71">
        <path
            android:fillColor="@color/icon_accent"
            android:pathData="M38.5,70L69.5,70A1,1 0 0,1 69.5,72L38.5,72A1,1 0 0,1 38.5,70Z" />
    </group>
</vector>
