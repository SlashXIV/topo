# ---------------------------------------------------------------------------
#  Gradle
# ---------------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Specifique a la machine : chemin du SDK Android. Ne doit jamais etre versionne.
local.properties

# ---------------------------------------------------------------------------
#  Android
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
output.json
release/
# Exception : les sources propres au build de publication, dont le baseline
# profile genere (app/src/release/generated), sont versionnees.
!app/src/release/
captures/

# Rapports lint / tests
lint-results*.html
lint-results*.xml
lint-results*.txt

# ---------------------------------------------------------------------------
#  NDK / CMake
# ---------------------------------------------------------------------------
.cxx/
obj/
.externalNativeBuild/
cmake-build-*/

# ---------------------------------------------------------------------------
#  IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.kotlin/

# ---------------------------------------------------------------------------
#  Modeles ML
#  Volumineux et binaires : hors git (Git LFS ou artefact de release).
#  Le schema Room exporte (core/data/schemas/*.json) est au contraire VERSIONNE :
#  c'est lui qui rend les migrations verifiables.
# ---------------------------------------------------------------------------
*.onnx
*.pt
*.pth
*.tflite
ml/datasets/
ml/runs/
ml/.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
#  Systeme
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.hprof

# Modele de substitution du Sprint 10 (AGPL-3.0) : regenere par
# ml/export_placeholder.py, jamais versionne.
vision/src/androidTest/assets/placeholder/
# Reference du relief, produite par ml/depth_model.py.
vision/src/androidTest/assets/depth/
# ONNX Runtime reduit, produit par third_party/onnxruntime/build_reduced_aar.sh.
third_party/onnxruntime/dist/
